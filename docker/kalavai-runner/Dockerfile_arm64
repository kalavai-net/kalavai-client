ARG K3S_TAG="v1.37.1-k3s1-arm64"

FROM rancher/k3s:$K3S_TAG AS k3s
FROM arm64v8/ubuntu:24.04

# Install pre-requisites
RUN apt update && apt install wireguard open-iscsi nfs-common -y

COPY --from=k3s / / --exclude=/bin
COPY --from=k3s /bin /bin

# Deploy defaults on startup
COPY deployments/* /var/lib/rancher/k3s/server/manifests/

RUN mkdir -p /workspace
COPY run_agent.sh /workspace/
RUN chmod +x /workspace/run_agent.sh

VOLUME /var/lib/kubelet
VOLUME /var/lib/rancher/k3s
VOLUME /var/lib/cni
VOLUME /var/log

ENV PATH="$PATH:/bin/aux"

ENTRYPOINT ["/workspace/run_agent.sh"]
